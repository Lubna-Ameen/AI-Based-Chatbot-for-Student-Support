PORT=3002
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?appName=<app-name>
DB_CONNECTION_TIMEOUT_MS=30000
DB_SOCKET_TIMEOUT_MS=45000
DB_MAX_POOL_SIZE=10
DB_MIN_POOL_SIZE=0

# Local troubleshooting only. Do not enable this in production.
# Use only when a local proxy/antivirus/corporate network is breaking TLS certificate validation.
MONGODB_TLS_ALLOW_INVALID_CERTS=false
