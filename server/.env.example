PORT=3002
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?appName=<app-name>
DB_CONNECTION_TIMEOUT_MS=30000
DB_SOCKET_TIMEOUT_MS=45000
DB_MAX_POOL_SIZE=10
DB_MIN_POOL_SIZE=0
CLIENT_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Set these bcrypt hashes from the existing Admin passwords before first Admin login.
# Existing account records are seeded once; later environment changes never overwrite stored passwords.
ADMIN_1_PASSWORD_HASH=
ADMIN_2_PASSWORD_HASH=

# Optional thresholds. Risk flags remain unavailable until UTAS-approved thresholds are configured.
ADMIN_LOW_GPA_THRESHOLD=
ADMIN_ATTENDANCE_THRESHOLD=

# Local troubleshooting only. Do not enable this in production.
# Use only when a local proxy/antivirus/corporate network is breaking TLS certificate validation.
MONGODB_TLS_ALLOW_INVALID_CERTS=false
